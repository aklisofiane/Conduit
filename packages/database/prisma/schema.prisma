// Conduit data model — see docs/data-model.md for the authoritative spec.
//
// Principles:
// - Nodes live inside `Workflow.definition` JSON (one atomic write, trivial versioning).
// - Credentials are normalized because they're reused across workflows and need rotation.
// - `ExecutionLog` = append-only high-volume stream for audit + live replay.
// - `TicketBranch` is a naming cache for `ticket-branch` workspaces (branch state lives on the remote).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Workflows
// -----------------------------------------------------------------------------

// STANDARD workflows are user-authored and surface everywhere. A single hidden
// SYSTEM workflow per org hosts internal analysis runs (see RepoAnalysis) so the
// `WorkflowRun → Workflow` FK and same-org invariant stay intact; every workflow
// list/validate path filters SYSTEM out so it never reaches the user.
enum WorkflowKind {
  STANDARD
  SYSTEM
}

model Workflow {
  id            String       @id @default(cuid())
  // Tenant column — every business-data row belongs to exactly one
  // organization. Writers stamp this on create and never let it cross over;
  // readers filter by it. See docs/data-model.md for the same-org invariant.
  orgId         String
  // Discriminator. STANDARD (default) for user workflows; SYSTEM for the
  // per-org hidden row backing internal analysis runs. Filtered out of every
  // user-facing list/validate path.
  kind          WorkflowKind @default(STANDARD)
  name          String
  description   String?
  // { trigger, nodes: Node[], edges: Edge[], mcpServers: WorkflowMcpServer[], ui: CanvasUI }
  // See @conduit/shared `WorkflowDefinition` for the Zod-validated shape.
  definition    Json
  isActive      Boolean      @default(true)
  // Webhook signing secret for verifying inbound deliveries to this
  // workflow's webhook URL (`POST /api/hooks/:workflowId`). Encrypted at
  // rest (AES-256-GCM). Nullable — polling-only workflows don't need one.
  // Single-secret per workflow; rotating overwrites. See docs/SECURITY.md.
  webhookSecret String?
  // Frozen, human-readable slug woven into every Temporal id (schedule,
  // poll/cron runs, agent runs) as a cosmetic prefix so operators can read
  // the workflow + source connection off a Temporal row at a glance. Written
  // once by the API the first time the workflow materializes a schedule or
  // run (`null → value`), then read by API + worker. Never changes after
  // first assignment — the immutable cuid stays the sole determinism anchor.
  // See .specs/temporal-id-slug.md.
  temporalSlug  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runs         WorkflowRun[]
  pollSnapshot PollSnapshot?

  @@index([isActive])
  @@index([orgId, isActive])
  @@index([orgId, kind])
}

// -----------------------------------------------------------------------------
// Connections & credentials
// -----------------------------------------------------------------------------

// A rotatable platform secret (e.g. a GitHub PAT). One row per token. Rotation
// updates `secret` in place and propagates to every Connection that references
// it, so workflows pick up the new token without rebinding.
model Credential {
  id        String   @id @default(cuid())
  orgId     String
  platform  Platform
  name      String
  // Encrypted at rest (AES-256-GCM). See docs/SECURITY.md.
  secret    String
  // Bare hostname (no scheme, no trailing slash). VCS platforms only.
  // Written once on first create; null for non-VCS platforms.
  hostUrl   String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connections  Connection[]

  @@index([platform])
  @@index([orgId, createdAt])
}

// A named, typed binding on top of a Credential — the unit a workflow actually
// references. `scope` is a Zod-validated discriminated union (see
// `@conduit/shared/connection`); the Prisma layer just stores it as JSON.
//
// One Credential can back many Connections (one PAT bound to a repo *and* a
// board = two Connection rows pointing at one Credential). Resolution at run
// time walks Connection → Credential and decrypts the secret. The
// `Connection.orgId` invariant (must equal `Credential.orgId`) is enforced by
// the writer — no FK in Postgres.
model Connection {
  id           String   @id @default(cuid())
  orgId        String
  credentialId String
  name         String
  scope        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  credential   Credential     @relation(fields: [credentialId], references: [id])
  analyses     RepoAnalysis[]

  @@index([credentialId])
  @@index([orgId, createdAt])
}

// -----------------------------------------------------------------------------
// Repo analysis (component-based review-workflow suggestions)
// -----------------------------------------------------------------------------

// One row per analysis of a repo Connection — owns the user-facing lifecycle on
// the connection. The analysis orchestrator (`repoAnalysisWorkflow`) runs its
// agent steps under a hidden internal `WorkflowRun` (`internalRunId`, FK'd to
// the per-org SYSTEM Workflow), so `status`/`phase` here are workflow-owned and
// independent of that run's `RunStatus`. The latest row per connection drives
// the badge + suggestions gallery. See .specs/repo-analyzer.md.
model RepoAnalysis {
  id                String             @id @default(cuid())
  orgId             String
  connectionId      String
  status            RepoAnalysisStatus @default(PENDING)
  phase             RepoAnalysisPhase  @default(DISCOVER)
  // WorkflowRun.id of the hidden internal run hosting analyzer NodeRuns. Plain
  // String (not an FK relation) — both rows cascade-delete with the org.
  internalRunId     String
  // Validated `TemplateFile` bundle of suggested per-component workflows.
  resultBundle      Json?
  // Components that failed Design fan-out, surfaced in the gallery.
  droppedComponents Json?
  error             String?
  // Set when the user imports this analysis's suggestions. Lets the gallery /
  // pill reflect "already imported" across reloads so re-opening the gallery
  // can't silently create duplicate workflows. Null until the first import.
  importedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([orgId, createdAt])
}

// Workflow-owned analysis lifecycle, independent of the internal RunStatus.
enum RepoAnalysisStatus {
  PENDING
  ANALYZING
  READY
  FAILED
}

// Coarse progress signal for the connection's progress card.
enum RepoAnalysisPhase {
  DISCOVER
  DESIGN
  ASSEMBLE
}

// Superset covering every platform Conduit stores credentials for.
// TriggerEvent.source is the subset that can trigger workflows (github, gitlab, jira).
enum Platform {
  GITHUB
  GITLAB
  JIRA
  SLACK
  DISCORD
}

// -----------------------------------------------------------------------------
// Provider configs
// -----------------------------------------------------------------------------

// Per-org API key + optional base URL for an agent provider (`claude` | `codex`).
// Consumed directly by the agent runtime — never bound to a Connection, never
// referenced from a workflow definition. At most one row per (orgId, providerId).
// `encryptedApiKey` uses the same AES-256-GCM envelope as `Credential.secret`
// (see docs/SECURITY.md). `extraEnv` is reserved for future Bedrock-style auth.
model ProviderConfig {
  id              String   @id @default(cuid())
  orgId           String
  providerId      String
  encryptedApiKey String
  baseUrl         String?
  extraEnv        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, providerId])
  @@index([orgId])
}

// -----------------------------------------------------------------------------
// Model pricing overrides
// -----------------------------------------------------------------------------

// Per-org per-model USD price override (per 1M tokens). Sparse — only models a
// user has overridden get a row; everything else falls back to the shipped
// `MODEL_PRICING` defaults in @conduit/shared. Drives snapshot-at-write cost on
// NodeRun. Decoupled from ProviderConfig (which is unique-per-provider and may
// not exist when a provider runs off an env API key).
model ModelPrice {
  id         String   @id @default(cuid())
  orgId      String
  // e.g. "claude-opus-4-8". Matches AgentConfig.model / PROVIDER_MODELS.
  model      String
  inputPerM  Decimal  @db.Decimal(12, 6)
  outputPerM Decimal  @db.Decimal(12, 6)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, model])
  @@index([orgId])
}

// -----------------------------------------------------------------------------
// Polling dedup
// -----------------------------------------------------------------------------

// One row per polling-mode workflow. Overwritten each poll cycle within a transaction.
// Created on first poll, deleted on workflow delete (cascade). No history — just the last state.
// The poll activity diffs current matching IDs against this snapshot to find new entries.
model PollSnapshot {
  id          String   @id @default(cuid())
  // Denormalized from Workflow.orgId for defense-in-depth; the writer (poll
  // activity) copies it from the loaded workflow row.
  orgId       String
  workflowId  String   @unique
  matchingIds Json
  polledAt    DateTime @default(now())

  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// ticket-branch naming cache
// -----------------------------------------------------------------------------

// One row per (platform, repo, ticket) touched by a `ticket-branch` workflow.
// Purely a naming cache — the branch itself lives on the remote. Keeps the slug
// stable across runs even if the ticket title is edited later. Shared across
// workflows: a Worker and a Critic targeting the same ticket converge on one row.
// See docs/design-docs/branch-management.md.
model TicketBranch {
  id         String    @id @default(cuid())
  // Tenant-scoped so two orgs working the same Github repo / ticket don't
  // collide on slug. Within a single org, Worker + Critic on the same ticket
  // still converge on one row (the desired shared-naming property).
  orgId      String
  platform   Platform
  // Bare hostname of the VCS instance (e.g. 'github.com', 'ghe.example.com').
  // Part of the unique key so same-named repos on different hosts stay distinct.
  hostUrl    String    @default("github.com")
  owner      String
  repo       String
  // TriggerEvent.issue.key — user-visible identifier as a string ("42" for GitHub,
  // "PROJ-123" for Jira). Never the opaque issue.id.
  ticketId   String
  slug       String
  // Stored verbatim: conduit/<ticketId>-<slug>.
  branchName String
  baseRef    String?
  createdAt  DateTime  @default(now())
  lastRunAt  DateTime?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, platform, hostUrl, owner, repo, ticketId])
  @@index([platform, owner, repo])
}

// -----------------------------------------------------------------------------
// Runs
// -----------------------------------------------------------------------------

model WorkflowRun {
  id                 String    @id @default(cuid())
  // Copied from Workflow.orgId at run-start. Same-org invariant: must equal
  // the parent Workflow's orgId — the writer maintains this.
  orgId              String
  workflowId         String
  status             RunStatus @default(PENDING)
  // Normalized TriggerEvent.
  trigger            Json
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  error              String?
  // Populated when the run is started.
  temporalWorkflowId String?
  temporalRunId      String?
  // Run-level rollups, summed from this run's NodeRun rows at finalization
  // (cleanup-run.ts). Tokens come from each NodeRun.usage JSON; cost is the
  // sum of the per-node snapshot-at-write `costUsd`. SQL-aggregatable record
  // powering tokens/cost per run and future spend dashboards. Null until the
  // run finalizes (or for runs with no completed agent nodes).
  totalInputTokens   Int?
  totalOutputTokens  Int?
  totalCostUsd       Decimal?  @db.Decimal(12, 6)

  workflow     Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nodes        NodeRun[]
  logs         ExecutionLog[]

  @@index([workflowId, startedAt])
  @@index([status])
  @@index([orgId, startedAt])
}

// WorkflowRun: PENDING (row created) -> RUNNING (Temporal started) -> COMPLETED | FAILED | CANCELLED.
// NodeRun:     PENDING (graph loaded) -> RUNNING (activity started) -> COMPLETED | FAILED | CANCELLED.
enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model NodeRun {
  id             String    @id @default(cuid())
  // Copied from WorkflowRun.orgId at upsert time.
  orgId          String
  runId          String
  // Matches definition.nodes[i].name.
  nodeName       String
  nodeType       NodeType
  status         RunStatus @default(PENDING)
  startedAt      DateTime?
  finishedAt     DateTime?
  // { files?: string[], workspacePath: string } — real output lives in .conduit/<nodeName>.md.
  output         Json?
  error          String?
  // { inputTokens, outputTokens, toolCalls, turns } — agent nodes only.
  usage          Json?
  // Snapshot-at-write dollar cost of this node, frozen at completion so later
  // price edits never rewrite history. Computed from the accumulated usage and
  // the price resolved for `node.model`. Agent nodes only; null otherwise.
  costUsd        Decimal?  @db.Decimal(12, 6)
  // The exact price used: { inputPerM, outputPerM, source: 'default' | 'override' }.
  // Makes each row self-explaining and auditable.
  priceSnapshot  Json?
  // Populated if inherited downstream.
  workspacePath  String?
  // Snapshot of `.conduit/<nodeName>.md` captured at the end of the node run.
  // The workspace is deleted after the run — persisting the summary here lets
  // the run detail page show it after cleanup. Freeform markdown, no schema.
  conduitSummary String?

  run          WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeName])
  @@index([runId])
}

enum NodeType {
  TRIGGER
  AGENT
}

// -----------------------------------------------------------------------------
// Execution logs (append-only, high volume)
// -----------------------------------------------------------------------------

model ExecutionLog {
  id       String           @id @default(cuid())
  // Copied from WorkflowRun.orgId at write time.
  orgId    String
  runId    String
  nodeName String?
  ts       DateTime         @default(now())
  level    LogLevel         @default(INFO)
  // One row per AgentEvent or system event. Kept narrow for fast append.
  kind     ExecutionLogKind
  payload  Json

  run          WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([runId, ts])
  @@index([runId, nodeName, ts])
}

enum ExecutionLogKind {
  TEXT
  TOOL_CALL
  TOOL_RESULT
  USAGE
  SYSTEM
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// -----------------------------------------------------------------------------
// Better Auth
// -----------------------------------------------------------------------------
// Generated by `npx @better-auth/cli generate` (Better Auth core + organization
// plugin) and pasted in. Better Auth populates these tables itself; do NOT
// reference them from Conduit business code — go through the Better Auth
// instance in `apps/api/src/auth/`.

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id              String           @id
  name            String
  slug            String
  logo            String?
  createdAt       DateTime
  metadata        String?
  members         Member[]
  invitations     Invitation[]
  // Back-relations to tenant-scoped business data. Cascade-deletes in those
  // models clean up all org-owned rows when the org row is removed (deletion
  // is gated by Better Auth's organization plugin in v1; see SPEC out-of-scope).
  workflows       Workflow[]
  credentials     Credential[]
  connections     Connection[]
  pollSnapshots   PollSnapshot[]
  workflowRuns    WorkflowRun[]
  nodeRuns        NodeRun[]
  executionLogs   ExecutionLog[]
  ticketBranches  TicketBranch[]
  providerConfigs ProviderConfig[]
  modelPrices     ModelPrice[]
  repoAnalyses    RepoAnalysis[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// -----------------------------------------------------------------------------
// Audit log
// -----------------------------------------------------------------------------
// Snapshot-style security event log. Plain string columns for actorUserId /
// orgId / targetUserId — deliberately NOT FKs, so audit rows survive user/org
// deletion. Append-only at the application layer; operators retain SQL access
// for retention/redaction. See docs/data-model.md and docs/SECURITY.md.

model AuditLog {
  id           String   @id @default(cuid())
  // Closed event taxonomy enforced in TypeScript (see audit-events.ts).
  // Stored as a plain string so future events can land without a migration.
  event        String
  // Plain string — not an FK. Null for failed sign-ins where credentials did
  // not match any user row.
  actorUserId  String?
  // Snapshot at write time so failed-login spikes correlate by email even
  // when actorUserId is null.
  actorEmail   String?
  // Best-effort from req.ip / X-Forwarded-For; null for non-HTTP events.
  actorIp      String?
  // Plain string — not an FK. Null for auth.* events that pre-date org
  // context (sign-up, sign-in).
  orgId        String?
  // Plain string — not an FK. Set for org.member.* events where actor != target.
  targetUserId String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([orgId, createdAt(sort: Desc)])
  @@index([actorEmail, event, createdAt])
  @@map("audit_log")
}
