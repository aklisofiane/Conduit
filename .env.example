# ----- Database -----
# Postgres from docker-compose.yml (port 5434 to avoid collision with a local 5432).
DATABASE_URL="postgresql://conduit:conduit@localhost:5434/conduit?schema=public"

# ----- Temporal -----
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="conduit-workflows"

# ----- Redis -----
REDIS_URL="redis://localhost:6379"

# ----- API -----
API_PORT=3001
CONDUIT_CORS_ORIGIN="http://localhost:5173"
# "local" | "hosted". Default "local". Drives rate-limit aggressiveness later;
# does not gate which auth providers exist (config-only, not flow-divergent).
CONDUIT_DEPLOYMENT="local"
# Dev-only webhook escape hatch (accepts this value as any signature). Leave empty in prod.
WEBHOOK_DEV_SECRET=""

# ----- Auth (Better Auth) -----
# Required for signing session cookies. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# Public URL of the API as the browser sees it. Used for OAuth redirect URIs.
BETTER_AUTH_URL="http://localhost:3001"
# GitHub OAuth — populate both halves to enable the GitHub button. Either
# deployment mode (local|hosted) gets the button when configured.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ----- Web -----
# Vite reads VITE_*; keep these prefixed.
VITE_API_URL="http://localhost:3001"

# ----- Worker / providers -----
# Which agent provider adapter to load. "claude" | "codex" | "stub" (Phase 1.5+).
CONDUIT_PROVIDER="claude"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Long-lived Claude Code OAuth token from `claude setup-token`. Lets local dev
# auth via OAuth instead of an API key, without mounting ~/.claude/ into the
# runner. Forwarded to the runner via the protocol; the SDK reads it from
# CLAUDE_CODE_OAUTH_TOKEN env. Mutually preferred over ANTHROPIC_API_KEY when set.
CLAUDE_CODE_OAUTH_TOKEN=""

# How Codex authenticates inside the runner.
#   api-key      (default) — uses OPENAI_API_KEY above.
#   oauth-mount  (local dev) — additionally bind-mounts ~/.codex/auth.json into
#                the runner so the Codex SDK reuses your `codex login` token.
#                Codex-only; Claude is handled by CLAUDE_CODE_OAUTH_TOKEN above
#                and ignores this setting. Materially weaker trust boundary —
#                a compromised agent can read or rewrite the host file.
#                Don't enable in shared / prod.
CONDUIT_AGENT_AUTH="api-key"

# AES-256-GCM key for PlatformCredential.secret (SECURITY.md). Leave empty on single-host dev
# to auto-generate ~/.conduit/key; set explicitly when DB and app run on different hosts.
CONDUIT_ENCRYPTION_KEY=""

# Root for everything Conduit writes on disk: runs/, base-clones/, key. Defaults to
# ~/.conduit when unset. Per-run agent-runner containers bind-mount paths under this
# root at the same absolute path inside the container, so set it to a stable
# deployment path (e.g. /var/lib/conduit) in production rather than a user home dir.
CONDUIT_HOME=""
