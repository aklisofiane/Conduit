{
  "id": "analyze",
  "name": "Analyze",
  "description": "Analyze a new issue, internally review the plan for gaps, and update the issue description with a grounded implementation approach. Triggered on GitHub issues.opened.",
  "category": "triage",
  "workflows": [
    {
      "name": "Analyze",
      "description": "Reads a freshly opened issue, inspects the source code, reviews the analysis for gaps, and updates the issue body with a marked Conduit analysis section.",
      "definition": {
        "triggers": [
          {
            "id": "trigger-analyze",
            "name": "AnalyzeTrigger",
            "platform": "github",
            "connectionId": "<github-repo>",
            "type": "webhook",
            "event": "issues.opened",
            "filters": []
          }
        ],
        "nodes": [
          {
            "id": "agent-research",
            "name": "Research",
            "presetId": "research",
            "mcpServers": [{ "serverId": "github-mcp" }],
            "skills": []          },
          {
            "id": "agent-review",
            "name": "Review",
            "presetId": "reviewer",
            "instructionsAppend": "You are reviewing the upstream Research agent's plan in `.conduit/`. Do not post to GitHub from this node — the downstream Publish agent handles all GitHub updates. Focus on whether the final output should be an implementation approach or a clarification question.",
            "mcpServers": [],
            "skills": []
          },
          {
            "id": "agent-publish",
            "name": "Publish",
            "presetId": "publish",
            "mcpServers": [{ "serverId": "github-mcp" }],
            "skills": []
          }
        ],
        "edges": [
          { "from": "AnalyzeTrigger", "to": "Research" },
          { "from": "Research", "to": "Review" },
          { "from": "Review", "to": "Publish" }
        ],
        "mcpServers": [
          {
            "id": "github-mcp",
            "presetId": "github",
            "connectionId": "<github-repo>"
          }
        ],
        "ui": {
          "nodePositions": {
            "AnalyzeTrigger": { "x": 80, "y": 120 },
            "Research": { "x": 360, "y": 120 },
            "Review": { "x": 640, "y": 120 },
            "Publish": { "x": 920, "y": 120 }
          },
          "viewport": { "x": 0, "y": 0, "zoom": 1 }
        }
      }
    }
  ]
}
