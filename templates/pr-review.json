{
  "id": "pr-review",
  "name": "PR Review",
  "description": "Review a newly opened pull request. Posts inline comments and a summary review.",
  "category": "review",
  "workflows": [
    {
      "name": "PR Review",
      "description": "Reads the PR diff, posts inline comments where appropriate, leaves a summary review.",
      "definition": {
        "triggers": [
          {
            "id": "trigger-pr-review",
            "name": "PRReviewTrigger",
            "platform": "github",
            "connectionId": "<github>",
            "mode": { "kind": "webhook", "event": "pull_request.opened" },
            "filters": []
          }
        ],
        "nodes": [
          {
            "id": "agent-pr-review",
            "name": "Review",
            "presetId": "reviewer",
            "instructionsAppend": "A pull request has just been opened. Read the PR metadata from the trigger context, check out the PR branch in your workspace, and review the diff against the base branch. Read local guidance such as CLAUDE.md or CONTRIBUTING.md when present.",
            "mcpServers": [{ "serverId": "github-mcp" }],
            "skills": [],
            "workspace": { "kind": "repo-clone", "connectionId": "<github>" }
          }
        ],
        "edges": [{ "from": "PRReviewTrigger", "to": "Review" }],
        "mcpServers": [
          {
            "id": "github-mcp",
            "name": "GitHub",
            "transport": {
              "kind": "stdio",
              "command": "npx",
              "args": ["-y", "@modelcontextprotocol/server-github"],
              "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{{credential}}" }
            },
            "connectionId": "<github>"
          }
        ],
        "ui": {
          "nodePositions": {
            "PRReviewTrigger": { "x": 80, "y": 120 },
            "Review": { "x": 440, "y": 120 }
          },
          "viewport": { "x": 0, "y": 0, "zoom": 1 }
        }
      }
    }
  ]
}
