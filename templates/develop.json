{
  "id": "develop",
  "name": "Develop",
  "description": "Multi-agent development pipeline: Dev + Tests + Docs fan out in parallel, QA merges and opens a draft PR. Triggered on status = \"Dev\".",
  "category": "develop",
  "workflows": [
    {
      "name": "Develop",
      "description": "Polling on status=Dev. Dev + Tests + Docs work in parallel branched worktrees; QA consumes the merged workspace and opens a draft PR.",
      "definition": {
        "triggers": [
          {
            "id": "trigger-develop",
            "name": "DevelopTrigger",
            "platform": "github",
            "connectionId": "<github>",
            "mode": { "kind": "polling", "intervalSec": 60 },
            "filters": [{ "field": "status", "op": "eq", "value": "Dev" }],
            "board": { "ownerType": "org", "owner": "acme", "number": 1 }
          }
        ],
        "nodes": [
          {
            "id": "agent-seed",
            "name": "Seed",
            "presetId": "research",
            "instructionsAppend": "Your final summary is the plan Dev / Tests / Docs will read in parallel — list the files, the intended change per file, and anything downstream agents need to know.",
            "mcpServers": [{ "serverId": "github-mcp" }],
            "skills": []          },
          {
            "id": "agent-dev",
            "name": "Dev",
            "presetId": "developer",
            "instructionsAppend": "Sibling agents Tests and Docs run in parallel — do not touch test files or user-facing documentation. Focus only on production code.",
            "mcpServers": [],
            "skills": []          },
          {
            "id": "agent-tests",
            "name": "Tests",
            "presetId": "tests",
            "mcpServers": [],
            "skills": []          },
          {
            "id": "agent-docs",
            "name": "Docs",
            "presetId": "docs",
            "mcpServers": [],
            "skills": []          },
          {
            "id": "agent-qa",
            "name": "QA",
            "presetId": "qa",
            "instructionsAppend": "After opening the draft PR, move the ticket to the \"Review\" column on the board.",
            "mcpServers": [{ "serverId": "github-mcp" }],
            "skills": []          }
        ],
        "edges": [
          { "from": "DevelopTrigger", "to": "Seed" },
          { "from": "Seed", "to": "Dev" },
          { "from": "Seed", "to": "Tests" },
          { "from": "Seed", "to": "Docs" },
          { "from": "Dev", "to": "QA" },
          { "from": "Tests", "to": "QA" },
          { "from": "Docs", "to": "QA" }
        ],
        "mcpServers": [
          {
            "id": "github-mcp",
            "name": "GitHub",
            "transport": {
              "kind": "streamable-http",
              "url": "https://api.githubcopilot.com/mcp/",
              "headers": { "Authorization": "Bearer {{credential}}" }
            },
            "connectionId": "<github>"
          }
        ],
        "ui": {
          "nodePositions": {
            "DevelopTrigger": { "x": 60, "y": 60 },
            "Seed": { "x": 240, "y": 60 },
            "Dev": { "x": 80, "y": 240 },
            "Tests": { "x": 240, "y": 240 },
            "Docs": { "x": 400, "y": 240 },
            "QA": { "x": 240, "y": 420 }
          },
          "viewport": { "x": 0, "y": 0, "zoom": 1 }
        }
      }
    }
  ]
}
