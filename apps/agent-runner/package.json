{
  "name": "@conduit/agent-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Per-run agent execution sandbox. Reads a RunnerRequest on stdin, drives a provider session, streams RunnerEvents on stdout. One process per run.",
  "main": "./dist/main.js",
  "bin": {
    "agent-runner": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc --build && docker build -t agent-runner:dev -f Dockerfile ../..",
    "build:ts": "tsc --build",
    "dev": "tsc --build --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.131",
    "@conduit/agent": "0.0.0",
    "@conduit/shared": "0.0.0",
    "@openai/codex-sdk": "^0.128.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
