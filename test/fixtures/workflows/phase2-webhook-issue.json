{
  "name": "Phase 2 webhook — issue triage",
  "description": "Single-agent workflow wired to the GitHub issues.opened webhook, used by the Phase 2 exit-criterion E2E test. Runs against StubProvider.",
  "definition": {
    "triggers": [
      {
        "id": "trigger-phase2",
        "name": "Phase2Trigger",
        "platform": "github",
        "connectionId": "__placeholder__",
        "type": "webhook",
        "event": "issues.opened",
        "filters": []
      }
    ],
    "nodes": [
      {
        "id": "agent-triage",
        "name": "Triage",
        "provider": "claude",
        "model": "stub-model",
        "instructions": "Read the issue, post a triage comment via GitHub.",
        "mcpServers": [{ "serverId": "github-mcp" }],
        "skills": []
      }
    ],
    "edges": [{ "from": "Phase2Trigger", "to": "Triage" }],
    "mcpServers": [
      {
        "id": "github-mcp",
        "name": "GitHub",
        "transport": {
          "kind": "streamable-http",
          "url": "https://api.githubcopilot.com/mcp/",
          "headers": { "Authorization": "Bearer {{credential}}" }
        }
      }
    ],
    "ui": {
      "nodePositions": {
        "Phase2Trigger": { "x": 80, "y": 120 },
        "Triage": { "x": 440, "y": 120 }
      },
      "viewport": { "x": 0, "y": 0, "zoom": 1 }
    }
  }
}
